<?xml version="1.0" encoding="UTF-8"?>
<!--
  Filewinch MSI (WiX Toolset v3, built by cargo-wix from scripts/package-windows.ps1).
  A per-user install: no admin prompt, files under %LOCALAPPDATA%\Programs\Filewinch, a Start
  Menu shortcut that carries the AppUserModelID app.xpdt.filewinch (the id the app gives its
  process, so the taskbar groups its windows under this shortcut's icon), and the icon in
  Settings > Apps.

  Variables: cargo-wix passes Version, Platform and CargoTargetBinDir; the packaging script
  passes RepoRoot (the repository's root, for the icon) with -C -dRepoRoot=...

  Keep UpgradeCode fixed for the life of the product: it is how a newer MSI finds and replaces
  an installed older one.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Filewinch"
           UpgradeCode="7D097FD3-07E3-4855-A184-3FE235251EB6"
           Manufacturer="xpdt"
           Language="1033"
           Codepage="1252"
           Version="$(var.Version)">

    <Package Id="*"
             Keywords="Installer"
             Description="Filewinch $(var.Version) installer"
             Manufacturer="xpdt"
             InstallerVersion="500"
             Languages="1033"
             Compressed="yes"
             InstallScope="perUser"
             InstallPrivileges="limited"
             SummaryCodepage="1252"
             Platform="$(var.Platform)"/>

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Filewinch is already installed. Uninstall it first to install this one."/>
    <MediaTemplate EmbedCab="yes"/>

    <Icon Id="filewinch.ico" SourceFile="$(var.RepoRoot)\assets\icon\filewinch.ico"/>
    <Property Id="ARPPRODUCTICON" Value="filewinch.ico"/>
    <Property Id="ARPNOMODIFY" Value="1"/>
    <Property Id="ARPNOREPAIR" Value="1"/>
    <Property Id="DISABLEADVTSHORTCUTS" Value="1"/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsDir" Name="Programs">
          <Directory Id="INSTALLDIR" Name="Filewinch"/>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder"/>
    </Directory>

    <!-- Per-user components take an HKCU value as their key path (ICE38) and remove the
         folders they create (ICE64). -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="FilewinchExe" Guid="*">
        <File Id="FilewinchExe" Name="Filewinch.exe" Source="$(var.CargoTargetBinDir)\filewinch.exe"/>
        <File Id="FilewinchIco" Name="filewinch.ico" Source="$(var.RepoRoot)\assets\icon\filewinch.ico"/>
        <RegistryValue Root="HKCU" Key="Software\xpdt\Filewinch" Name="InstallDir" Type="string"
                       Value="[INSTALLDIR]" KeyPath="yes"/>
        <RemoveFolder Id="RemoveInstallDir" On="uninstall"/>
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall"/>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="FilewinchShortcut"
                  Name="Filewinch"
                  Description="Browse, transfer and sync files with servers and cloud storage"
                  Target="[INSTALLDIR]Filewinch.exe"
                  WorkingDirectory="INSTALLDIR"
                  Icon="filewinch.ico">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="app.xpdt.filewinch"/>
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\xpdt\Filewinch" Name="StartMenuShortcut" Type="integer"
                       Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="Filewinch" Level="1" Absent="disallow">
      <ComponentRef Id="FilewinchExe"/>
      <ComponentRef Id="StartMenuShortcut"/>
    </Feature>
  </Product>
</Wix>
